# ── 必需：Jev（居民层的每一个判断都走它）
OPENROUTER_API_KEY=


# ── 街区观察者（可选）
# 不填 OPENAI_API_KEY 就自动跳过这一层，小镇照样跑。
#
# 任何兼容 OpenAI Responses API 的 provider 都可以，注意是 /responses
# 而不是 /chat/completions——deepseek、minimax、openai 都原生支持。
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=
OBSERVER_MODEL=MiniMax-M3


# ── 其它（可选）
# 花费上限（美元），默认 0.05；界面上也能用滑块改
# JEV_TOWN_COST_CAP=0.05
